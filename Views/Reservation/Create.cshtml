@model EMS.ViewModels.ReservationCreateViewModel
@{
    ViewData["Title"] = "New reservation";

    var investor = Model.Investors.FirstOrDefault(i => i.Id == Model.InvestorId);
    var sector = Model.Sectors.FirstOrDefault(s => s.Id == Model.SectorId);

    string WindowsFor(int sectorId) => string.Join(", ", Model.InvestorWindows
        .Where(w => w.SectorId == sectorId)
        .Select(w => $"{w.StartTime:h:mm tt} – {w.EndTime:h:mm tt}"));

    var noTimes = sector != null && !Model.TimeOptions.Any();
}

<div class="ems-page-header">
    <div>
        <div class="ems-breadcrumb"><a asp-action="Index">Reservations</a> / New</div>
        <h1>New reservation</h1>
        <p class="ems-subtitle">Pick each step in order. Later lists only show options that still match.</p>
    </div>
</div>

<partial name="_StatusMessages" />

@* Steps 1-3 are a GET form: each choice reloads the page with the next step's options. *@
<form asp-action="Create" method="get" class="ems-card ems-card-body mb-4">
    <div class="row g-3">
        <div class="col-md-6 col-xl-3">
            <label class="ems-step-label" for="investorId"><span class="ems-step-number">1</span> Investor</label>
            <select class="form-select" id="investorId" name="investorId" onchange="this.form.submit()">
                <option value="">Choose an investor…</option>
                @foreach (var i in Model.Investors)
                {
                    <option value="@i.Id" selected="@(i.Id == Model.InvestorId)">@i.Name</option>
                }
            </select>
        </div>

        <div class="col-md-6 col-xl-3 @(investor == null ? "ems-step-disabled" : "")">
            <label class="ems-step-label" for="sectorId"><span class="ems-step-number">2</span> Sector</label>
            @if (investor == null)
            {
                <select class="form-select" id="sectorId" disabled><option>—</option></select>
            }
            else
            {
                <select class="form-select" id="sectorId" name="sectorId" onchange="this.form.submit()">
                    <option value="">Choose a sector…</option>
                    @foreach (var s in Model.Sectors)
                    {
                        <option value="@s.Id" selected="@(s.Id == Model.SectorId)">@s.Name (@WindowsFor(s.Id))</option>
                    }
                </select>
            }
        </div>

        <div class="col-md-6 col-xl-3 @(sector == null || noTimes ? "ems-step-disabled" : "")">
            <label class="ems-step-label" for="start"><span class="ems-step-number">3</span> Time</label>
            @if (sector == null)
            {
                <select class="form-select" id="start" disabled><option>—</option></select>
            }
            else if (noTimes)
            {
                <select class="form-select" id="start" disabled><option>No times available</option></select>
            }
            else
            {
                <select class="form-select" id="start" name="start" onchange="this.form.submit()">
                    <option value="">Choose a time…</option>
                    @foreach (var time in Model.TimeOptions)
                    {
                        <option value="@time.Start.ToString("HH:mm")" selected="@(time == Model.Meeting)">@time</option>
                    }
                </select>
            }
        </div>

        <div class="col-md-6 col-xl-3 @(Model.Meeting == null ? "ems-step-disabled" : "")">
            <span class="ems-step-label"><span class="ems-step-number">4</span> Presenter + Room</span>
            <select class="form-select" disabled>
                <option>@(Model.Meeting == null ? "—" : "Choose in the card below")</option>
            </select>
        </div>
    </div>
    <noscript><button type="submit" class="btn btn-outline-secondary mt-3">Next</button></noscript>
</form>

@if (investor != null && !Model.Sectors.Any())
{
    <div class="alert alert-warning col-lg-8" role="alert">
        <partial name="_Icon" model="@("warning")" />
        <div class="ems-alert-text">
            <strong>No sectors yet.</strong>
            @investor.Name has no time windows. Add them on the <a asp-controller="Investor" asp-action="Manage" asp-route-id="@investor.Id">investor's page</a> first.
        </div>
    </div>
}

@if (noTimes)
{
    <div class="alert alert-warning col-lg-8" role="alert">
        <partial name="_Icon" model="@("warning")" />
        <div class="ems-alert-text">
            <strong>No match found</strong><br />
            No free room slot fits inside both @investor!.Name's @sector!.Name availability (@WindowsFor(sector.Id))
            and the availability of a @sector.Name presenter. Try another sector, or add a slot on the
            <a asp-controller="Hotel" asp-action="Index">Hotels</a> page.
        </div>
    </div>
}

@if (Model.Meeting is { } meeting)
{
    <form asp-action="Create" method="post" class="ems-card ems-card-accent col-lg-8">
        <input type="hidden" name="investorId" value="@Model.InvestorId" />
        <input type="hidden" name="sectorId" value="@Model.SectorId" />
        <input type="hidden" name="start" value="@meeting.Start.ToString("HH:mm")" />

        <div class="ems-card-header">
            <h2>Confirm reservation</h2>
            <span class="ems-badge-ok">Slot available</span>
        </div>

        <div class="ems-card-body">
            <dl class="row ems-summary mb-0 align-items-center">
                <dt class="col-sm-4 mb-3">Investor</dt>
                <dd class="col-sm-8 mb-3">@investor!.Name</dd>

                <dt class="col-sm-4 mb-3">Sector</dt>
                <dd class="col-sm-8 mb-3">@sector!.Name</dd>

                <dt class="col-sm-4 mb-3">Time</dt>
                <dd class="col-sm-8 mb-3">@meeting (1 hour)</dd>

                <dt class="col-sm-4 mb-3"><label for="presenterId">Presenter</label></dt>
                <dd class="col-sm-8 mb-3">
                    <select class="form-select" id="presenterId" name="presenterId" required>
                        <option value="">Choose a presenter…</option>
                        @foreach (var presenter in Model.Presenters)
                        {
                            <option value="@presenter.Id">@presenter.Name</option>
                        }
                    </select>
                </dd>

                <dt class="col-sm-4"><label for="roomSlotId">Room</label></dt>
                <dd class="col-sm-8 mb-0">
                    <select class="form-select" id="roomSlotId" name="roomSlotId" required>
                        <option value="">Choose a free room…</option>
                        @foreach (var hotel in Model.Slots.GroupBy(s => s.Room!.Hotel!.Name))
                        {
                            <optgroup label="@hotel.Key">
                                @foreach (var slot in hotel)
                                {
                                    <option value="@slot.Id">@slot.Room!.Name · @hotel.Key</option>
                                }
                            </optgroup>
                        }
                    </select>
                </dd>
            </dl>
        </div>

        <div class="ems-card-footer d-flex gap-3 align-items-center">
            <button type="submit" class="btn btn-primary">Confirm reservation</button>
            <a asp-action="Create" class="btn btn-link">Start over</a>
        </div>
    </form>
}
