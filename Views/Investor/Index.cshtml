@model IEnumerable<EMS.Models.Investor>
@{
    ViewData["Title"] = "Investors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Investors</h1>
    <a asp-action="Create" class="btn btn-primary">Add Investor</a>
</div>

<partial name="_StatusMessages" />

@if (!Model.Any())
{
    <p class="text-muted">No investors yet.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Mobile</th>
                <th>Sectors &amp; availability</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var investor in Model)
        {
            <tr>
                <td>@investor.Name</td>
                <td>@investor.Mobile</td>
                <td>
                    @foreach (var interest in investor.Interests.OrderBy(x => x.Sector!.Name).ThenBy(x => x.StartTime))
                    {
                        <span class="badge text-bg-light border me-1">
                            @interest.Sector!.Name: @interest.StartTime.ToString("h:mm tt") – @interest.EndTime.ToString("h:mm tt")
                        </span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Manage" asp-route-id="@investor.Id" class="btn btn-sm btn-outline-primary">Manage sectors</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
