@model IEnumerable<EMS.Models.Investor>
@{
    ViewData["Title"] = "Investors";
}

<div class="ems-page-header">
    <div>
        <h1>Investors</h1>
        <p class="ems-subtitle">Each investor lists the sectors they want to meet and when they are free.</p>
    </div>
    <div class="ems-page-actions">
        <a asp-action="Create" class="btn btn-primary btn-lg">+ Add investor</a>
    </div>
</div>

<partial name="_StatusMessages" />

<div class="ems-card">
    @if (!Model.Any())
    {
        <div class="ems-card-body text-muted">No investors yet. Add the first one.</div>
    }
    else
    {
        <table class="table ems-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Mobile</th>
                    <th>Sectors &amp; availability</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var investor in Model)
            {
                <tr>
                    <td class="ems-name">@investor.Name</td>
                    <td class="text-nowrap">@investor.Mobile</td>
                    <td>
                        @if (!investor.Interests.Any())
                        {
                            <span class="text-muted">No sectors yet</span>
                        }
                        @foreach (var interest in investor.Interests.OrderBy(x => x.Sector!.Name).ThenBy(x => x.StartTime))
                        {
                            <span class="ems-chip"><strong>@interest.Sector!.Name:</strong> @interest.StartTime.ToString("h:mm tt") – @interest.EndTime.ToString("h:mm tt")</span>
                        }
                    </td>
                    <td class="ems-actions">
                        <a asp-action="Manage" asp-route-id="@investor.Id" class="btn btn-outline-secondary">Manage</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
