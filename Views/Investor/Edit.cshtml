@model EMS.Models.Investor
@{
    ViewData["Title"] = "Edit Investor";
}

<p><a asp-action="Manage" asp-route-id="@Model.Id">&larr; Back to investor</a></p>
<h1>Edit Investor</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Mobile" class="form-label"></label>
        <input asp-for="Mobile" class="form-control" />
        <span asp-validation-for="Mobile" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Manage" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
