@model EMS.Models.InvestorInterest
@{
    ViewData["Title"] = "Edit time window";
}

<div class="ems-page-header">
    <div>
        <div class="ems-breadcrumb"><a asp-action="Index">Investors</a> / <a asp-action="Manage" asp-route-id="@Model.InvestorId">@Model.Investor!.Name</a> / Edit time window</div>
        <h1>Edit time window</h1>
        <p class="ems-subtitle">@Model.Investor!.Name · @Model.Sector!.Name</p>
    </div>
</div>

<form asp-action="EditInterest" asp-route-id="@Model.Id" method="post" class="ems-card ems-form-card">
    <div class="ems-card-body">
        @if (ViewData["Error"] is string error)
        {
            <div class="alert alert-danger" role="alert">
                <partial name="_Icon" model="@("error")" />
                <div class="ems-alert-text">@error</div>
            </div>
        }
        <div class="row g-3">
            <div class="col-sm-6">
                <label class="form-label" for="from">From</label>
                <input type="time" class="form-control" id="from" name="from" value="@Model.StartTime.ToString("HH:mm")" required />
            </div>
            <div class="col-sm-6">
                <label class="form-label" for="to">To</label>
                <input type="time" class="form-control" id="to" name="to" value="@Model.EndTime.ToString("HH:mm")" required />
            </div>
        </div>
    </div>
    <div class="ems-card-footer d-flex gap-3 align-items-center">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Manage" asp-route-id="@Model.InvestorId" class="btn btn-link">Cancel</a>
    </div>
</form>
