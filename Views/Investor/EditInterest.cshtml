@model EMS.Models.InvestorInterest
@{
    ViewData["Title"] = "Edit Time Window";
}

<p><a asp-action="Manage" asp-route-id="@Model.InvestorId">&larr; Back to @Model.Investor!.Name</a></p>
<h1>Edit Time Window</h1>
<p class="text-muted">@Model.Investor!.Name — @Model.Sector!.Name</p>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form asp-action="EditInterest" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end">
    <div class="col-auto">
        <label class="form-label" for="from">From</label>
        <input type="time" class="form-control" id="from" name="from" value="@Model.StartTime.ToString("HH:mm")" required />
    </div>
    <div class="col-auto">
        <label class="form-label" for="to">To</label>
        <input type="time" class="form-control" id="to" name="to" value="@Model.EndTime.ToString("HH:mm")" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Manage" asp-route-id="@Model.InvestorId" class="btn btn-secondary">Cancel</a>
    </div>
</form>
