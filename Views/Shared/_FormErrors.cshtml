@{
    var errorCount = ViewData.ModelState.Values.Count(v => v.Errors.Count > 0);
}
@if (errorCount > 0)
{
    <div class="alert alert-danger" role="alert">
        <partial name="_Icon" model="@("error")" />
        <div class="ems-alert-text">Please fix the @(errorCount == 1 ? "field" : $"{errorCount} fields") below.</div>
    </div>
}
