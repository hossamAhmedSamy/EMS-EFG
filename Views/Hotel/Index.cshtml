@model IEnumerable<EMS.Models.Hotel>
@{
    ViewData["Title"] = "Hotels";
}

<div class="ems-page-header">
    <div>
        <h1>Hotels</h1>
        <p class="ems-subtitle">Each hotel has conference rooms, and each room offers 1-hour slots.</p>
    </div>
    <div class="ems-page-actions">
        <a asp-action="Create" class="btn btn-primary btn-lg">+ Add hotel</a>
    </div>
</div>

<partial name="_StatusMessages" />

<div class="ems-card">
    @if (!Model.Any())
    {
        <div class="ems-card-body text-muted">No hotels yet. Add the first one.</div>
    }
    else
    {
        <table class="table ems-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Rooms</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var hotel in Model)
            {
                <tr>
                    <td class="ems-name">@hotel.Name</td>
                    <td>@hotel.Address</td>
                    <td>@hotel.Rooms.Count</td>
                    <td class="ems-actions">
                        <a asp-action="Manage" asp-route-id="@hotel.Id" class="btn btn-outline-secondary">Manage</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
