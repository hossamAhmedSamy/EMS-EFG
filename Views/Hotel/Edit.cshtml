@model EMS.Models.Hotel
@{
    ViewData["Title"] = "Edit hotel";
}

<div class="ems-page-header">
    <div>
        <div class="ems-breadcrumb"><a asp-action="Index">Hotels</a> / <a asp-action="Manage" asp-route-id="@Model.Id">Manage</a> / Edit</div>
        <h1>Edit hotel</h1>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ems-card ems-form-card">
    <div class="ems-card-body">
        <partial name="_FormErrors" />
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>
        <div>
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" placeholder="Optional" />
            <span asp-validation-for="Address"></span>
        </div>
    </div>
    <div class="ems-card-footer d-flex gap-3 align-items-center">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Manage" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
