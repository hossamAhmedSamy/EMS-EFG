@model EMS.ViewModels.HotelManageViewModel
@{
    ViewData["Title"] = Model.Hotel.Name;
}

<div class="ems-page-header">
    <div>
        <div class="ems-breadcrumb"><a asp-action="Index">Hotels</a> / Manage</div>
        <h1>@Model.Hotel.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Hotel.Address))
        {
            <p class="ems-subtitle">@Model.Hotel.Address</p>
        }
    </div>
    <div class="ems-page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Hotel.Id" class="btn btn-outline-secondary btn-lg">Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Hotel.Id" method="post"
              onsubmit="return confirm('Delete this hotel with all its rooms and slots?');">
            <button type="submit" class="btn btn-outline-danger btn-lg">Delete</button>
        </form>
    </div>
</div>

<partial name="_StatusMessages" />

<div class="row g-4">
    @foreach (var room in Model.Hotel.Rooms.OrderBy(r => r.Name))
    {
        <div class="col-lg-6">
            <div class="ems-card h-100 d-flex flex-column">
                <div class="ems-card-header">
                    <h2>@room.Name</h2>
                    <div class="d-flex gap-2 align-items-center">
                        <a asp-action="EditRoom" asp-route-id="@room.Id" class="btn btn-link">Rename</a>
                        <form asp-action="DeleteRoom" asp-route-id="@room.Id" method="post"
                              onsubmit="return confirm('Delete this room and all its slots?');">
                            <button type="submit" class="btn btn-outline-danger">Remove room</button>
                        </form>
                    </div>
                </div>

                <div class="ems-card-body ems-bg-muted flex-grow-1">
                    @if (room.RoomSlots.Any())
                    {
                        <ul class="ems-slot-list">
                        @foreach (var slot in room.RoomSlots.OrderBy(s => s.StartTime))
                        {
                            var reserved = Model.ReservedSlotIds.Contains(slot.Id);
                            <li class="ems-slot @(reserved ? "ems-slot-reserved" : "")">
                                <span>@slot.StartTime.ToString("h:mm tt") – @slot.EndTime.ToString("h:mm tt")</span>
                                @if (reserved)
                                {
                                    <span class="ems-badge-reserved">Reserved</span>
                                }
                                else
                                {
                                    <form asp-action="RemoveSlot" method="post" class="d-inline">
                                        <input type="hidden" name="slotId" value="@slot.Id" />
                                        <button type="submit" class="ems-slot-remove" title="Remove slot" aria-label="Remove slot">&times;</button>
                                    </form>
                                }
                            </li>
                        }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No slots yet. Add the first one below.</p>
                    }
                </div>

                <form asp-action="GenerateSlots" method="post" class="ems-card-footer">
                  <input type="hidden" name="roomId" value="@room.Id" />
                  <div class="row g-2 align-items-end">
                    <div class="col">
                        <label class="form-label" for="from-@room.Id">From</label>
                        <input type="time" class="form-control" id="from-@room.Id" name="from" required />
                    </div>
                    <div class="col">
                        <label class="form-label" for="to-@room.Id">To</label>
                        <input type="time" class="form-control" id="to-@room.Id" name="to" required />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary btn-input-height">Add</button>
                    </div>
                    <div class="col-12 small text-muted">Cut into back-to-back 1-hour slots; overlaps are skipped.</div>
                  </div>
                </form>
            </div>
        </div>
    }

    <div class="col-lg-6">
        <form asp-action="AddRoom" method="post" class="ems-add-room h-100 p-4">
            <input type="hidden" name="hotelId" value="@Model.Hotel.Id" />
            <h2 class="ems-card-title mb-3">Add a room</h2>
            <label class="form-label" for="roomName">Room name</label>
            <div class="d-flex gap-2">
                <input class="form-control" id="roomName" name="roomName" placeholder="e.g. Salon C" required maxlength="50" />
                <button type="submit" class="btn btn-outline-secondary text-nowrap">Add room</button>
            </div>
        </form>
    </div>
</div>
