@model EMS.Models.Room
@{
    ViewData["Title"] = "Rename Room";
}

<p><a asp-action="Manage" asp-route-id="@Model.HotelId">&larr; Back to @Model.Hotel!.Name</a></p>
<h1>Rename Room</h1>

<form asp-action="EditRoom" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Manage" asp-route-id="@Model.HotelId" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
