@model EMS.Models.Room
@{
    ViewData["Title"] = "Rename room";
}

<div class="ems-page-header">
    <div>
        <div class="ems-breadcrumb"><a asp-action="Index">Hotels</a> / <a asp-action="Manage" asp-route-id="@Model.HotelId">@Model.Hotel!.Name</a> / Rename room</div>
        <h1>Rename room</h1>
    </div>
</div>

<form asp-action="EditRoom" asp-route-id="@Model.Id" method="post" class="ems-card ems-form-card">
    <div class="ems-card-body">
        <partial name="_FormErrors" />
        <label asp-for="Name" class="form-label">Room name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name"></span>
    </div>
    <div class="ems-card-footer d-flex gap-3 align-items-center">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Manage" asp-route-id="@Model.HotelId" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
