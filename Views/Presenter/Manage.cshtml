@model EMS.ViewModels.PresenterManageViewModel
@{
    ViewData["Title"] = Model.Presenter.Name;
}

<div class="ems-page-header">
    <div>
        <div class="ems-breadcrumb"><a asp-action="Index">Presenters</a> / Manage</div>
        <h1>@Model.Presenter.Name</h1>
        <p class="ems-subtitle">Mobile: @Model.Presenter.Mobile</p>
    </div>
    <div class="ems-page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Presenter.Id" class="btn btn-outline-secondary btn-lg">Edit</a>
        <form asp-action="Delete" asp-route-id="@Model.Presenter.Id" method="post"
              onsubmit="return confirm('Delete this presenter and all their time windows?');">
            <button type="submit" class="btn btn-outline-danger btn-lg">Delete</button>
        </form>
    </div>
</div>

<partial name="_StatusMessages" />

<div class="ems-card">
    <div class="ems-card-header">
        <h2>Time windows</h2>
        <span class="text-muted small">When this presenter is free, per sector</span>
    </div>

    @if (!Model.Presenter.Interests.Any())
    {
        <div class="ems-card-body text-muted">No time windows yet. Add one below.</div>
    }
    else
    {
        <table class="table ems-table">
            <thead>
                <tr>
                    <th>Sector</th>
                    <th>From</th>
                    <th>To</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var interest in Model.Presenter.Interests.OrderBy(x => x.Sector!.Name).ThenBy(x => x.StartTime))
            {
                <tr>
                    <td class="ems-name">@interest.Sector!.Name</td>
                    <td>@interest.StartTime.ToString("h:mm tt")</td>
                    <td>@interest.EndTime.ToString("h:mm tt")</td>
                    <td class="ems-actions">
                        <a asp-action="EditInterest" asp-route-id="@interest.Id" class="btn btn-outline-secondary">Edit</a>
                        <form asp-action="RemoveInterest" method="post" class="d-inline">
                            <input type="hidden" name="interestId" value="@interest.Id" />
                            <button type="submit" class="btn btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

    <form asp-action="AddInterest" method="post" class="ems-card-footer">
      <input type="hidden" name="presenterId" value="@Model.Presenter.Id" />
      <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="sectorId">Sector</label>
            <select class="form-select" id="sectorId" name="sectorId" required>
                <option value="">Choose a sector…</option>
                @foreach (var sector in Model.Sectors)
                {
                    <option value="@sector.Id">@sector.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="from">From</label>
            <input type="time" class="form-control" id="from" name="from" required />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="to">To</label>
            <input type="time" class="form-control" id="to" name="to" required />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary btn-input-height">Add window</button>
        </div>
        <div class="col-12 small text-muted">A sector can have several windows (e.g. 2–3 PM and 4–6 PM), as long as they don't overlap.</div>
      </div>
    </form>
</div>
