    <DTS:Executable
      DTS:refId="Package\Insert new hotels"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Inserts staged hotels whose name is not in dbo.Hotels yet (trimmed, de-duplicated across files)."
      DTS:DTSID="{6E1C3042-D6F8-491A-B5B6-C1D2E3F4051C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Insert new hotels"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2016; © 2015 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A3C1E5F7-2B4D-4E6F-8A0B-1C2D3E4F5A61}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Hotels (Name, Address)&#xA;SELECT s.Name, LEFT(MAX(s.Address), 200)&#xA;FROM (SELECT TRIM(Name) AS Name, NULLIF(TRIM(Address), N'') AS Address&#xA;      FROM dbo.HotelImportStaging) AS s&#xA;WHERE s.Name &lt;&gt; N'' AND LEN(s.Name) &lt;= 100&#xA;  AND NOT EXISTS (SELECT 1 FROM dbo.Hotels AS h WHERE h.Name = s.Name)&#xA;GROUP BY s.Name;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
