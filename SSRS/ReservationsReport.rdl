<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>All reserved slots with investor, presenter, hotel and room.</Description>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="EMS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=EMS</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>4f1b6a0e-2c7d-4b8e-9a31-5d6e7f8a9b01</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="Reservations">
      <Query>
        <DataSourceName>EMS</DataSourceName>
        <CommandText>SELECT ReservationId, HotelName, RoomName, StartTime, EndTime, SectorName,
       InvestorName, InvestorMobile, PresenterName, PresenterMobile
FROM dbo.vw_ReservationReport
ORDER BY StartTime, HotelName, RoomName;</CommandText>
      </Query>
      <Fields>
        <Field Name="ReservationId">
          <DataField>ReservationId</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="HotelName">
          <DataField>HotelName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RoomName">
          <DataField>RoomName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartTime">
          <DataField>StartTime</DataField>
          <rd:TypeName>System.TimeSpan</rd:TypeName>
        </Field>
        <Field Name="EndTime">
          <DataField>EndTime</DataField>
          <rd:TypeName>System.TimeSpan</rd:TypeName>
        </Field>
        <Field Name="SectorName">
          <DataField>SectorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InvestorName">
          <DataField>InvestorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="InvestorMobile">
          <DataField>InvestorMobile</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PresenterName">
          <DataField>PresenterName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PresenterMobile">
          <DataField>PresenterMobile</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
